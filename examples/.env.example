# Copy to .env in the folder you run the bot from and fill in. Never commit the filled-in file.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Pipecat on Daily only (python examples/turn_blend_bot.py -t daily)
DAILY_API_KEY=

